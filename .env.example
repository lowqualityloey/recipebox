# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored (see .gitignore).

# PostgreSQL connection string used by Prisma and Better Auth.
# Local dev with the bundled Postgres runner (npm run db:start):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/recipebox"

# Better Auth
# Public origin of the app (used by Better Auth as its base URL).
BETTER_AUTH_URL="http://localhost:3000"
# Secret used to sign sessions — generate one with:
#   npx -y auth@latest secret
BETTER_AUTH_SECRET="replace-me-with-a-generated-secret"
